# A virtual screen for Steam, which needs one even on a server.
#
# Only programs given its cookie (in ~/houridle/Xauthority, readable only by
# you) can draw on it or watch it; other users on the server can't. A new
# cookie is made each time it starts. ("$$" is systemd's way to write "$".)
[Unit]
Description=houridle: virtual display for Steam

[Service]
Environment=XAUTHORITY=%h/houridle/Xauthority
ExecStartPre=/bin/sh -c 'umask 077 && : >"$$XAUTHORITY" && chmod 600 "$$XAUTHORITY" && xauth -q -f "$$XAUTHORITY" add :99 . "$$(od -An -N16 -tx1 /dev/urandom | tr -dc 0-9a-f)"'
ExecStart=/usr/bin/Xvfb :99 -screen 0 1280x800x24 -nolisten tcp -auth %h/houridle/Xauthority
# Ready once the display's socket exists, so Steam doesn't start too early.
ExecStartPost=/bin/sh -c 'for i in $$(seq 100); do [ -S /tmp/.X11-unix/X99 ] && exit 0; sleep 0.1; done; echo "Xvfb did not open display :99" >&2; exit 1'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
