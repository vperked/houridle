# houridle's .gitignore. The built page (backend/views/web/page/dist) is not
# committed: make and build.bat build it from frontend/ first.

# ---- Builds ----
# make and build.bat build into bin/; run houridle from there and its own
# files (config.json, the log, the Steam API library) stay there too.
/bin/
/houridle
*.exe
*.exe~
*.exe.old
houridle-linux-*
houridle-darwin-*
/dist/
*.test
*.out

# ---- Your own files, which houridle keeps next to itself ----
# They hold secrets (the page's key, a webhook, a GitHub token) or are
# personal (hours history, what's been spent). Sign-ins are kept elsewhere,
# in your user config folder, never in this repository.
config.json
config.json.*.tmp
history.json
history-*.json
*.json.bad
steam-settings.json
cm-servers.json
.houridle-update-*
steam_api64.dll
libsteam_api.so

# ---- Logs ----
*.log
*.log.[0-9]
npm-debug.log*

# ---- Secrets that should never be committed ----
.env
.env.*
*.pem
*.key

# ---- Frontend ----
/backend/views/web/page/dist/
frontend/node_modules/
frontend/.vite/
*.local

# ---- Go tooling ----
coverage.*
*.prof
go.work
go.work.sum

# ---- Editors and OS ----
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
